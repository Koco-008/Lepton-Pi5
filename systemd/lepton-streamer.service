[Unit]
Description=FLIR Lepton raw and false-color video streams
After=systemd-modules-load.service
Wants=systemd-modules-load.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStartPre=/usr/local/libexec/lepton/rpi_vsync_app
ExecStart=/usr/local/bin/lepton_streamer --input /dev/video0 --raw-output /dev/video10 --color-output /dev/video11 --color-width 640 --color-height 480
Restart=always
RestartSec=2
TimeoutStopSec=5
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
